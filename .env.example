# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Model options: gemini-2.5-flash, gemini-3.8-flash (or experimental aliases)
GEMINI_MODEL=gemini-2.5-flash

# Default temperature (0.7 is balanced between creative hooks and strict adherence)
TEMPERATURE=0.7

# Buffer Free API Keys (Get from https://publish.buffer.com/settings/api)
# Free plan includes 3 channels (X, LinkedIn, Threads).
BUFFER_API_KEY=your_buffer_personal_api_key_here
# Optional 2nd account for 3 more channels (e.g. Instagram, Facebook):
# BUFFER_API_KEY_2=your_second_buffer_api_key_here

# Substack Settings (Optional custom subdomain, e.g. 'mypublication')
# SUBSTACK_SUBDOMAIN=your_subdomain

# Telegram Bot Token (Get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
